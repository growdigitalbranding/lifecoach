# Where contact-form enquiries are delivered. With none of these set the form
# still works end to end and logs the enquiry instead of sending it, so the site
# is never silently broken in a preview environment.

# Resend (https://resend.com) — the simplest option.
RESEND_API_KEY=

# Must be an address at a domain verified with your provider.
CONTACT_FROM_EMAIL=

# Absolute origin, no trailing slash, e.g. https://yourdomain.com
# Used for canonical URLs, sitemap.xml and robots.txt. Leave this unset and the
# site falls back to localhost rather than guessing at a domain.
NEXT_PUBLIC_SITE_URL=
